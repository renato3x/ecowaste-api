@host = http://localhost:5162
@jwt =

POST {{host}}/api/auth/register
Content-Type: application/json

{
  "name": "Admin User",
  "email": "admin@ecowaste.com",
  "password": "123456",
  "role": "Admin"
}

###

POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@ecowaste.com",
  "password": "123456"
}

###

GET {{host}}/api/waste-records?page=1&page_size=10
Authorization: Bearer {{jwt}}

